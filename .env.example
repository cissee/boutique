# Copier ce fichier en .env.local puis remplacer les valeurs fictives.
# Ne jamais versionner .env.local.

# URL du projet Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIQUE uniquement (publishable key "sb_publishable_..." ou ancienne clé "anon").
# La sécurité repose sur les politiques RLS, pas sur le secret de cette clé.
# NE JAMAIS mettre ici la clé service_role ni une clé secrète "sb_secret_...".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL publique de l'application (liens des emails de confirmation / mot de passe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
